# Opcional: URL de Redis para caché y rate-limiting persistentes.
# Si se deja vacío o Redis no responde, se usa almacenamiento en memoria.
REDIS_URL=

PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
# [Opcional] Tope de resultados que se piden a Prowlarr por búsqueda (0 = sin límite)
PROWLARR_SEARCH_LIMIT=500
TMDB_API_KEY=
DELUGE_URL=
DELUGE_PASSWORD=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASSWORD=

# Clave de sesión de Flask. Si se deja vacía se usa un valor de desarrollo
# inseguro y la app avisa en el arranque: definila en producción.
SECRET_KEY=
# [Opcional] Token que protege /api/deluge/add. Si está vacío, el endpoint no
# exige autenticación (la app avisa en el arranque).
API_SECRET_TOKEN=
# [Opcional] Permitir destinos privados/loopback al descargar .torrent
# (Prowlarr local o en LAN). Los rangos de metadatos se bloquean siempre.
SSRF_ALLOW_PRIVATE_TARGETS=true
# [Opcional] Máximo de resoluciones de TMDB por búsqueda (0 = sin límite).
TMDB_MAX_RESOLUTIONS=40

# Servidor. En producción (Waitress) se usa este host/puerto.
HOST=127.0.0.1
PORT=5000
FLASK_ENV=production
